# Copy to .env; never commit .env. Existing OS variables take precedence.
# Required: your own local PostgreSQL database (URL-encode special password characters).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/ptashenya

# Required: keys for the SAME Clerk instance. Public keys must match.
# The VITE key is embedded in the browser bundle; rebuild after changing it.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Required: email of the shop owner in Clerk, not a password.
ADMIN_EMAIL=

# Production defaults. HOST=127.0.0.1 is safe behind a local Cloudflare Tunnel.
# Only use 0.0.0.0 if you deliberately need LAN access and configure Windows Firewall.
PORT=8080
HOST=127.0.0.1
NODE_ENV=production
LOG_LEVEL=info

# Optional: SAME Clerk proxy URL configured for your Clerk instance, or leave blank.
VITE_CLERK_PROXY_URL=

# Optional: supplier authentication. Leave BOTH blank if not used.
TOYSI_PHONE=
TOYSI_PASSWORD=
# Safe during migration. Set false only after checking imported data and supplier access.
DISABLE_SUPPLIER_SYNC=true

# Optional: CRM integration. Leave BOTH blank to disable.
MOIE_URL=
MOIE_WEBHOOK_TOKEN=

# Development-only settings (pnpm local:dev); not used by production start.
API_PORT=8080
VITE_PORT=5173
# The standalone production build always uses /. Replit can supply its own path.
BASE_PATH=/
# LOCAL_DEV, VITE_STANDALONE, SERVE_STOREFRONT and STOREFRONT_DIR are set by scripts.
# REPL_ID and other REPLIT_* variables are NOT required.
# SESSION_SECRET is not read by the current application.
