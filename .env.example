# Copy this file to .env and fill the local values.
# Never commit .env or share it in GitHub.

# Local PostgreSQL database. Create an empty database named ptashenya first.
DATABASE_URL=postgresql://postgres:change-this-password@127.0.0.1:5432/ptashenya

# Local app ports
API_PORT=8080
VITE_PORT=5173

# Copy the matching Clerk keys from the project's Replit Secrets into this local file.
# Keep the values private; do not paste them into GitHub or chat.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Local mode starts with supplier sync disabled so it cannot overwrite imported data.
