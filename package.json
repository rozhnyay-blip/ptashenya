{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "node scripts/preinstall.mjs",
    "build": "node scripts/build-production.mjs",
    "start": "node scripts/start-production.mjs",
    "test:production": "node scripts/test-production.mjs",
    "local:dev": "node --env-file=.env scripts/local-dev.mjs",
    "local:db:init": "node --env-file=.env scripts/run-pnpm.mjs --filter @workspace/db run push",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
